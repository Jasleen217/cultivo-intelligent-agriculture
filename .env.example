# GEMINI_API_KEY: Optional for live Gemini-powered AgriBot responses.
# When omitted, Cultivo transparently routes AgriBot to its deterministic Advisory Engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (defaults to 3000)
PORT=3000
